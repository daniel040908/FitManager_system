-- =========================================================
-- VIEWS DE CONSULTA
-- =========================================================
CREATE OR REPLACE VIEW vw_alunos AS
SELECT a.id, u.nome, u.email, a.cpf, a.telefone, a.dataInicio, a.status, p.id AS planoId, p.nome AS plano, p.valor AS valorPlano
FROM alunos a
INNER JOIN usuarios u ON u.id = a.usuarioId
LEFT JOIN planos p ON p.id = a.planoId;

CREATE OR REPLACE VIEW vw_treinos AS
SELECT t.id, t.nome, t.descricao, t.alunoId, aluno.nome AS aluno, t.instrutorId, instrutor.nome AS instrutor, t.createdAt, t.updatedAt
FROM treinos t
INNER JOIN alunos a ON a.id = t.alunoId
INNER JOIN usuarios aluno ON aluno.id = a.usuarioId
LEFT JOIN instrutores i ON i.id = t.instrutorId
LEFT JOIN usuarios instrutor ON instrutor.id = i.usuarioId;

CREATE OR REPLACE VIEW vw_pagamentos AS
SELECT pg.id, pg.alunoId, aluno.nome AS aluno, pg.planoId, p.nome AS plano, pg.valor, pg.vencimento, pg.status, pg.pagoEm
FROM pagamentos pg
INNER JOIN alunos a ON a.id = pg.alunoId
INNER JOIN usuarios aluno ON aluno.id = a.usuarioId
LEFT JOIN planos p ON p.id = pg.planoId;